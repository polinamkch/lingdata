        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@jsb2008f" PARTICIPANT="@jsb2008f" TIER_ID="gestComment@jsb2008f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1384" ANNOTATION_REF="a1173">
                <ANNOTATION_VALUE>подергивание плечами</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1385" ANNOTATION_REF="a1174">
                <ANNOTATION_VALUE>поглаживание рукой колени</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1386" ANNOTATION_REF="a1177">
                <ANNOTATION_VALUE>перебирание пальцами руки</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1388" ANNOTATION_REF="a1178">
                <ANNOTATION_VALUE>трет голову рукой</ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1390" ANNOTATION_REF="a1197">
                <ANNOTATION_VALUE>тут я имею в виду как бы эмоциональную, выражающуюся в жестах подготовку к вопросу, чтобы "выглядеть", звучать увереннее </ANNOTATION_VALUE>
            </REF_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="polinamkch" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="gesture_comment"
        PARENT_REF="gestType@pmm2009f" PARTICIPANT="@pmm2009f" TIER_ID="gestComment@pmm2009f">
        <ANNOTATION>
            <REF_ANNOTATION ANNOTATION_ID="a1387" ANNOTATION_REF="a1288">
                <ANNOTATION_VALUE>перебирает пальцами рук, вертит кольца; во всех последующий таких аннотациях имеется в виду то же самое</ANNOTATION_VALUE>
            </REF_ANNOTATION>
