                TIME_SLOT_REF1="ts1211" TIME_SLOT_REF2="ts1212">
                <ANNOTATION_VALUE>Еще другая эра.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1143"
                TIME_SLOT_REF1="ts1213" TIME_SLOT_REF2="ts1214">
                <ANNOTATION_VALUE>Но я еще как бы, еще свой стиль.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1144"
                TIME_SLOT_REF1="ts1215" TIME_SLOT_REF2="ts1216">
                <ANNOTATION_VALUE>И не понимаю, что мне лучше подходит.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1145"
                TIME_SLOT_REF1="ts1217" TIME_SLOT_REF2="ts1218">
                <ANNOTATION_VALUE>Конечно, с коротким волосами</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1146"
                TIME_SLOT_REF1="ts1219" TIME_SLOT_REF2="ts1220">
                <ANNOTATION_VALUE>намного удобнее.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1147"
                TIME_SLOT_REF1="ts1221" TIME_SLOT_REF2="ts1222">
                <ANNOTATION_VALUE>Но мне коротко не жаль,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1148"
                TIME_SLOT_REF1="ts1223" TIME_SLOT_REF2="ts1224">
                <ANNOTATION_VALUE>и намного легче было.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1149"
                TIME_SLOT_REF1="ts1225" TIME_SLOT_REF2="ts1226">
                <ANNOTATION_VALUE>Ну, посмотрим, что потом будет.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1150"
                TIME_SLOT_REF1="ts1227" TIME_SLOT_REF2="ts1228">
                <ANNOTATION_VALUE>Как тебе вообще начало в чем?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1151"
                TIME_SLOT_REF1="ts1229" TIME_SLOT_REF2="ts1230">
                <ANNOTATION_VALUE>В плане, типа...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1152"
                TIME_SLOT_REF1="ts1231" TIME_SLOT_REF2="ts1232">
                <ANNOTATION_VALUE>Ну, после, получается,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1153"
                TIME_SLOT_REF1="ts1233" TIME_SLOT_REF2="ts1234">
                <ANNOTATION_VALUE>у тебя был перерыв в чем?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1154"
                TIME_SLOT_REF1="ts1235" TIME_SLOT_REF2="ts1236">
                <ANNOTATION_VALUE>Прям челную какую-то систему.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1155"
                TIME_SLOT_REF1="ts1237" TIME_SLOT_REF2="ts1238">
                <ANNOTATION_VALUE>И как тебе вообще?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1156"
                TIME_SLOT_REF1="ts1239" TIME_SLOT_REF2="ts1240">
                <ANNOTATION_VALUE>Слышала.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1157"
                TIME_SLOT_REF1="ts1241" TIME_SLOT_REF2="ts1242">
                <ANNOTATION_VALUE>Ну, я была готова.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1158"
                TIME_SLOT_REF1="ts1243" TIME_SLOT_REF2="ts1244">
                <ANNOTATION_VALUE>Потому что, все-таки,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1159"
                TIME_SLOT_REF1="ts1245" TIME_SLOT_REF2="ts1246">
                <ANNOTATION_VALUE>этот университет,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1160"
                TIME_SLOT_REF1="ts1247" TIME_SLOT_REF2="ts1248">
                <ANNOTATION_VALUE>он говорит о том, что</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1161"
                TIME_SLOT_REF1="ts1249" TIME_SLOT_REF2="ts1250">
                <ANNOTATION_VALUE>здесь все-таки нужно учиться.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1162"
                TIME_SLOT_REF1="ts1251" TIME_SLOT_REF2="ts1252">
                <ANNOTATION_VALUE>И это хорошо.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1163"
                TIME_SLOT_REF1="ts1253" TIME_SLOT_REF2="ts1254">
                <ANNOTATION_VALUE>И я была к этому готова.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1164"
                TIME_SLOT_REF1="ts1255" TIME_SLOT_REF2="ts1256">
                <ANNOTATION_VALUE>Тяжело в большей степени</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1165"
                TIME_SLOT_REF1="ts1257" TIME_SLOT_REF2="ts1258">
                <ANNOTATION_VALUE>в том, что очень много информации.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1166"
                TIME_SLOT_REF1="ts1259" TIME_SLOT_REF2="ts1260">
                <ANNOTATION_VALUE>И этот человек, который</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1167"
                TIME_SLOT_REF1="ts1261" TIME_SLOT_REF2="ts1262">
                <ANNOTATION_VALUE>за все время-то хвататься,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1168"
                TIME_SLOT_REF1="ts1263" TIME_SLOT_REF2="ts1264">
                <ANNOTATION_VALUE>мне обычно очень тяжело выбрать,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1169"
                TIME_SLOT_REF1="ts1265" TIME_SLOT_REF2="ts1266">
                <ANNOTATION_VALUE>что он был.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1170"
                TIME_SLOT_REF1="ts1267" TIME_SLOT_REF2="ts1268">
                <ANNOTATION_VALUE>Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1171"
                TIME_SLOT_REF1="ts1269" TIME_SLOT_REF2="ts1270">
                <ANNOTATION_VALUE>Ну, опять...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1172"
                TIME_SLOT_REF1="ts1271" TIME_SLOT_REF2="ts1272">
                <ANNOTATION_VALUE>Что ж я могу сказать?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
