        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a921"
                TIME_SLOT_REF1="ts769" TIME_SLOT_REF2="ts770">
                <ANNOTATION_VALUE>Потому что очень развитая фруктура и транспорт.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a922"
                TIME_SLOT_REF1="ts771" TIME_SLOT_REF2="ts772">
                <ANNOTATION_VALUE>И тут в общем много возможностей.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a923"
                TIME_SLOT_REF1="ts773" TIME_SLOT_REF2="ts774">
                <ANNOTATION_VALUE>Петербург — он очень крутой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a924"
                TIME_SLOT_REF1="ts775" TIME_SLOT_REF2="ts776">
                <ANNOTATION_VALUE>У меня ассоциируется с культурой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a925"
                TIME_SLOT_REF1="ts777" TIME_SLOT_REF2="ts778">
                <ANNOTATION_VALUE>Николай II и все такое.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a926"
                TIME_SLOT_REF1="ts779" TIME_SLOT_REF2="ts780">
                <ANNOTATION_VALUE>И он очень радует своей красотой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a927"
                TIME_SLOT_REF1="ts781" TIME_SLOT_REF2="ts782">
                <ANNOTATION_VALUE>Но при этом надо расстраивать тем, что почему-то он, к сожалению, сейчас...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a928"
                TIME_SLOT_REF1="ts783" TIME_SLOT_REF2="ts784">
                <ANNOTATION_VALUE>Он не хочет делать никаких выводов.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a929"
                TIME_SLOT_REF1="ts785" TIME_SLOT_REF2="ts786">
                <ANNOTATION_VALUE>Он как будто бы раст цвета какого-то, как в Москве.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a930"
                TIME_SLOT_REF1="ts787" TIME_SLOT_REF2="ts788">
                <ANNOTATION_VALUE>Там нет на данный момент.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a931"
                TIME_SLOT_REF1="ts789" TIME_SLOT_REF2="ts790">
                <ANNOTATION_VALUE>Я просто пытаюсь заполнить паузы, придумать просто...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a932"
                TIME_SLOT_REF1="ts791" TIME_SLOT_REF2="ts792">
                <ANNOTATION_VALUE>Мне, например, в Питере кажется, что люди бывают такими...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a933"
                TIME_SLOT_REF1="ts793" TIME_SLOT_REF2="ts794">
                <ANNOTATION_VALUE>Недружелюбные, что роли закрыты, они в съемках по номерке.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a934"
                TIME_SLOT_REF1="ts795" TIME_SLOT_REF2="ts796">
                <ANNOTATION_VALUE>Да, а туристы вообще...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a935"
                TIME_SLOT_REF1="ts797" TIME_SLOT_REF2="ts798">
                <ANNOTATION_VALUE>Ну, возможно, это просто из-за подпризма того, что в Турции они местные.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a936"
                TIME_SLOT_REF1="ts799" TIME_SLOT_REF2="ts800">
                <ANNOTATION_VALUE>В Москве, мне кажется, вообще все, что угодно может происходить,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a937"
                TIME_SLOT_REF1="ts801" TIME_SLOT_REF2="ts802">
                <ANNOTATION_VALUE>типа это город рандом абсолютно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a938"
                TIME_SLOT_REF1="ts803" TIME_SLOT_REF2="ts804">
                <ANNOTATION_VALUE>В этом плане мне нравится Москва.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a939"
                TIME_SLOT_REF1="ts805" TIME_SLOT_REF2="ts806">
                <ANNOTATION_VALUE>Очень.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a940"
                TIME_SLOT_REF1="ts807" TIME_SLOT_REF2="ts808">
                <ANNOTATION_VALUE>Девизия ваша, не помню.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a941"
                TIME_SLOT_REF1="ts809" TIME_SLOT_REF2="ts810">
                <ANNOTATION_VALUE>Да, у меня есть цепочка маленькая.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a942"
                TIME_SLOT_REF1="ts811" TIME_SLOT_REF2="ts812">
                <ANNOTATION_VALUE>Алибиатра.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a943"
                TIME_SLOT_REF1="ts813" TIME_SLOT_REF2="ts814">
                <ANNOTATION_VALUE>Русский той тарьер.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a944"
                TIME_SLOT_REF1="ts815" TIME_SLOT_REF2="ts816">
                <ANNOTATION_VALUE>Странное название.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a945"
                TIME_SLOT_REF1="ts817" TIME_SLOT_REF2="ts818">
                <ANNOTATION_VALUE>Я не встречала вообще такого рода.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a946"
                TIME_SLOT_REF1="ts819" TIME_SLOT_REF2="ts820">
                <ANNOTATION_VALUE>Обычно их называют просто той тарьерах, а один русский той тарьер.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a947"
                TIME_SLOT_REF1="ts821" TIME_SLOT_REF2="ts822">
                <ANNOTATION_VALUE>Он маленький, нежеликий.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a948"
                TIME_SLOT_REF1="ts823" TIME_SLOT_REF2="ts824">
                <ANNOTATION_VALUE>Векает коричневым.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a949"
                TIME_SLOT_REF1="ts825" TIME_SLOT_REF2="ts826">
                <ANNOTATION_VALUE>Но он довольно добрый, в отличие от других маленьких.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a950"
                TIME_SLOT_REF1="ts827" TIME_SLOT_REF2="ts828">
                <ANNOTATION_VALUE>Здравствуйте.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a951"
                TIME_SLOT_REF1="ts829" TIME_SLOT_REF2="ts830">
                <ANNOTATION_VALUE>А как вы на самом деле?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a952"
                TIME_SLOT_REF1="ts831" TIME_SLOT_REF2="ts832">
                <ANNOTATION_VALUE>В 2016 году мы с вами поехали в Курск.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a953"
                TIME_SLOT_REF1="ts833" TIME_SLOT_REF2="ts834">
                <ANNOTATION_VALUE>Или в Мурчатов.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a954"
                TIME_SLOT_REF1="ts835" TIME_SLOT_REF2="ts836">
                <ANNOTATION_VALUE>Думал, что мы куда-то, да?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a955"
                TIME_SLOT_REF1="ts837" TIME_SLOT_REF2="ts838">
                <ANNOTATION_VALUE>И хотели как-то завести собаку.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a956"
                TIME_SLOT_REF1="ts839" TIME_SLOT_REF2="ts840">
                <ANNOTATION_VALUE>Ну, мало значит, я хотела.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a957"
                TIME_SLOT_REF1="ts841" TIME_SLOT_REF2="ts842">
                <ANNOTATION_VALUE>А я, конечно, за сколько мы там были?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a958"
                TIME_SLOT_REF1="ts843" TIME_SLOT_REF2="ts844">
                <ANNOTATION_VALUE>Первые 7-8 в этом месяц.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a959"
                TIME_SLOT_REF1="ts845" TIME_SLOT_REF2="ts846">
                <ANNOTATION_VALUE>И мы ездили по разному заводчику.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a960"
                TIME_SLOT_REF1="ts847" TIME_SLOT_REF2="ts848">
                <ANNOTATION_VALUE>И в итоге решили взять его.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a961"
                TIME_SLOT_REF1="ts849" TIME_SLOT_REF2="ts850">
                <ANNOTATION_VALUE>Потому что он вот такой красивенький маленький.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a962"
                TIME_SLOT_REF1="ts851" TIME_SLOT_REF2="ts852">
                <ANNOTATION_VALUE>Решили.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a963"
                TIME_SLOT_REF1="ts853" TIME_SLOT_REF2="ts854">
                <ANNOTATION_VALUE>Смешно очень.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a964"
                TIME_SLOT_REF1="ts855" TIME_SLOT_REF2="ts856">
                <ANNOTATION_VALUE>Отключается паразит, он не принялся сюда.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a965"
                TIME_SLOT_REF1="ts857" TIME_SLOT_REF2="ts858">
                <ANNOTATION_VALUE>То есть маленький или взрослый?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a966"
                TIME_SLOT_REF1="ts859" TIME_SLOT_REF2="ts860">
                <ANNOTATION_VALUE>Чуть-чуть побольше стал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a967"
                TIME_SLOT_REF1="ts861" TIME_SLOT_REF2="ts862">
                <ANNOTATION_VALUE>Мы взяли его таким образом.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a968"
                TIME_SLOT_REF1="ts863" TIME_SLOT_REF2="ts864">
                <ANNOTATION_VALUE>Побольше стал.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a969"
                TIME_SLOT_REF1="ts865" TIME_SLOT_REF2="ts866">
                <ANNOTATION_VALUE>Да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a970"
                TIME_SLOT_REF1="ts867" TIME_SLOT_REF2="ts868">
                <ANNOTATION_VALUE>Постарел.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a971"
                TIME_SLOT_REF1="ts869" TIME_SLOT_REF2="ts870">
                <ANNOTATION_VALUE>Сейчас он уже седой.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a972"
                TIME_SLOT_REF1="ts871" TIME_SLOT_REF2="ts872">
                <ANNOTATION_VALUE>Класс.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a973"
                TIME_SLOT_REF1="ts873" TIME_SLOT_REF2="ts874">
                <ANNOTATION_VALUE>Ты сколько можно сказал?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a974"
                TIME_SLOT_REF1="ts875" TIME_SLOT_REF2="ts876">
                <ANNOTATION_VALUE>Сколько?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a975"
                TIME_SLOT_REF1="ts877" TIME_SLOT_REF2="ts878">
                <ANNOTATION_VALUE>Я не вижу.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a976"
                TIME_SLOT_REF1="ts879" TIME_SLOT_REF2="ts880">
                <ANNOTATION_VALUE>Тринадцать минут.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a977"
                TIME_SLOT_REF1="ts881" TIME_SLOT_REF2="ts882">
                <ANNOTATION_VALUE>Тринадцать минут какие-то точно.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a978"
                TIME_SLOT_REF1="ts883" TIME_SLOT_REF2="ts884">
                <ANNOTATION_VALUE>У тебя есть субъемое место в Москве?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a979"
                TIME_SLOT_REF1="ts885" TIME_SLOT_REF2="ts886">
                <ANNOTATION_VALUE>Приберу место в Москве?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a980"
                TIME_SLOT_REF1="ts887" TIME_SLOT_REF2="ts888">
                <ANNOTATION_VALUE>Мне кажется, что я только в прошлом году начала как-то осознавать, что вообще я нахожусь в Москве и что она такая разносторонняя.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a981"
                TIME_SLOT_REF1="ts889" TIME_SLOT_REF2="ts890">
                <ANNOTATION_VALUE>Тут очень много неожиданных мест, и можно ходить не только на Красную площадь, там в центре,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a982"
                TIME_SLOT_REF1="ts891" TIME_SLOT_REF2="ts892">
                <ANNOTATION_VALUE>есть такие интересные места, которые прям...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a983"
                TIME_SLOT_REF1="ts893" TIME_SLOT_REF2="ts894">
                <ANNOTATION_VALUE>И я прошла сейчас в экразаведении, и просто...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a984"
                TIME_SLOT_REF1="ts895" TIME_SLOT_REF2="ts896">
                <ANNOTATION_VALUE>Это парки, и вот...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a985"
                TIME_SLOT_REF1="ts897" TIME_SLOT_REF2="ts898">
                <ANNOTATION_VALUE>Ну, например, очень нравится моя дорога от дома до сюда,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a986"
                TIME_SLOT_REF1="ts899" TIME_SLOT_REF2="ts900">
                <ANNOTATION_VALUE>потому что я иду с утра у Красной ворота,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a987"
                TIME_SLOT_REF1="ts901" TIME_SLOT_REF2="ts902">
                <ANNOTATION_VALUE>и там давно гусать, погусать, только единственное, в раке мы общаемся.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a988"
                TIME_SLOT_REF1="ts903" TIME_SLOT_REF2="ts904">
                <ANNOTATION_VALUE>Не веряю, у меня с точки падает солнце, светит очень жарко, я не могу осознаваться.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a989"
                TIME_SLOT_REF1="ts905" TIME_SLOT_REF2="ts906">
                <ANNOTATION_VALUE>Да, если именно вместо...</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a990"
                TIME_SLOT_REF1="ts907" TIME_SLOT_REF2="ts908">
                <ANNOTATION_VALUE>Моя память мне подгодит очень сильно, но на среднем, не верю, это из-за стресса.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a991"
                TIME_SLOT_REF1="ts909" TIME_SLOT_REF2="ts910">
                <ANNOTATION_VALUE>Но мне нравится парк... Лесопарк, наверное.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a992"
                TIME_SLOT_REF1="ts911" TIME_SLOT_REF2="ts912">
                <ANNOTATION_VALUE>Пицца, не знаю. Пиццовский, да.</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a993"
                TIME_SLOT_REF1="ts913" TIME_SLOT_REF2="ts914">
                <ANNOTATION_VALUE>Там Пиццовский лес, и там, наверное, есть Лесопарк,</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a994"
                TIME_SLOT_REF1="ts915" TIME_SLOT_REF2="ts916">
                <ANNOTATION_VALUE>и там как раз есть этот спортивный комплекс рядом с моей сестрой.</ANNOTATION_VALUE>
