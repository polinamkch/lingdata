        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a995"
                TIME_SLOT_REF1="ts917" TIME_SLOT_REF2="ts918">
                <ANNOTATION_VALUE>Мы туда часто ходили, и такое довольно тоже необычное место,</ANNOTATION_VALUE>
