    <TIER ANNOTATOR="polinamkch" DEFAULT_LOCALE="ru"
        LINGUISTIC_TYPE_REF="utterance" PARTICIPANT="@yasb2008f" TIER_ID="text@yasb2008f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts10" TIME_SLOT_REF2="ts16">
                <ANNOTATION_VALUE>да / смотрела / в кино</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a5"
                TIME_SLOT_REF1="ts17" TIME_SLOT_REF2="ts30">
                <ANNOTATION_VALUE>ааа / очень круто / я чуть не оглохла в моменте там</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a6"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts42">
                <ANNOTATION_VALUE>ну потому что очень громко / кричал там / циклоп</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a8"
                TIME_SLOT_REF1="ts43" TIME_SLOT_REF2="ts52">
                <ANNOTATION_VALUE>ну короче / это / знаменитый мем </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a9"
                TIME_SLOT_REF1="ts55" TIME_SLOT_REF2="ts62">
                <ANNOTATION_VALUE>вот / так да / очень сильно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a25"
                TIME_SLOT_REF1="ts63" TIME_SLOT_REF2="ts70">
                <ANNOTATION_VALUE>там / многие темы / были освещены</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a12"
                TIME_SLOT_REF1="ts71" TIME_SLOT_REF2="ts81">
                <ANNOTATION_VALUE>иии / это  / я прям оценила на самом деле </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a14"
                TIME_SLOT_REF1="ts91" TIME_SLOT_REF2="ts101">
                <ANNOTATION_VALUE>немного да / потому что хотела подготовиться</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a26"
                TIME_SLOT_REF1="ts103" TIME_SLOT_REF2="ts112">
                <ANNOTATION_VALUE>иначе считала себя как бы / как-то странно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a15"
                TIME_SLOT_REF1="ts113" TIME_SLOT_REF2="ts128">
                <ANNOTATION_VALUE>я иду / смотреть фильм / и при этом / с оригиналом никак не ознакомилась</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a16"
                TIME_SLOT_REF1="ts129" TIME_SLOT_REF2="ts144">
                <ANNOTATION_VALUE>но режиссерская версия / она конечно никак не повторяет / то / что писал Гомер</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a27"
                TIME_SLOT_REF1="ts145" TIME_SLOT_REF2="ts155">
                <ANNOTATION_VALUE>аа / но / это какое-то другое совсем видение художественное </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a18"
                TIME_SLOT_REF1="ts156" TIME_SLOT_REF2="ts176">
                <ANNOTATION_VALUE>но я все равно думала / что нужно чуть-чуть как-то ознакомиться / а то / как-то / неправильно </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a19"
                TIME_SLOT_REF1="ts177" TIME_SLOT_REF2="ts180">
                <ANNOTATION_VALUE>кха / вот </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a21"
                TIME_SLOT_REF1="ts204" TIME_SLOT_REF2="ts206">
                <ANNOTATION_VALUE>читаю</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a22"
                TIME_SLOT_REF1="ts207" TIME_SLOT_REF2="ts218">
                <ANNOTATION_VALUE>я / вообще / не приучена к этому / к сожалению</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
